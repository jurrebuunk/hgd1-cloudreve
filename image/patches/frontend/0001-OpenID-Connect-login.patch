diff --git a/src/component/Pages/Login/Signin/OidcLoginButton.tsx b/src/component/Pages/Login/Signin/OidcLoginButton.tsx
new file mode 100644
index 0000000..a956dc4
--- /dev/null
+++ b/src/component/Pages/Login/Signin/OidcLoginButton.tsx
@@ -0,0 +1,46 @@
+import { Button, ButtonProps } from "@mui/material";
+import { useEffect, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { getOidcLoginInfo } from "../../../../api/api.ts";
+import { ApiPrefix } from "../../../../api/request.ts";
+import { useAppDispatch } from "../../../../redux/hooks.ts";
+import { useQuery } from "../../../../util";
+import PersonLock from "../../../Icons/PersonLock.tsx";
+
+// The provider's display name when OIDC login is configured, else undefined.
+export function useOidcLogin(): string | undefined {
+  const dispatch = useAppDispatch();
+  const [name, setName] = useState<string | undefined>(undefined);
+  useEffect(() => {
+    dispatch(getOidcLoginInfo())
+      .then((info) => setName(info.enabled ? info.display_name : undefined))
+      .catch(() => setName(undefined));
+  }, []);
+  return name;
+}
+
+interface OidcLoginButtonProps extends ButtonProps {
+  name: string;
+}
+
+// Sign in through the OpenID Connect provider (backend: service/oidclogin).
+export default function OidcLoginButton({ name, ...rest }: OidcLoginButtonProps) {
+  const { t } = useTranslation();
+  const query = useQuery();
+
+  const start = () => {
+    // Back to where sign-in was asked for; inside the OAuth consent flow that
+    // is this page itself.
+    let redirect = query.get("redirect") ?? "";
+    if (!redirect && window.location.pathname !== "/session") {
+      redirect = window.location.pathname + window.location.search;
+    }
+    window.location.assign(`${ApiPrefix}/session/oidc/login?redirect=${encodeURIComponent(redirect)}`);
+  };
+
+  return (
+    <Button onClick={start} variant={"outlined"} startIcon={<PersonLock />} fullWidth {...rest}>
+      {t("login.oidcSignIn", { defaultValue: "Sign in with {{name}}", name })}
+    </Button>
+  );
+}
