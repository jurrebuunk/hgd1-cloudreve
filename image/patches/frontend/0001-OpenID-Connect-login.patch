+++ b/src/component/Pages/Login/OidcCallback.tsx
@@ -0,0 +1,74 @@
+import { Box, Button, Typography } from "@mui/material";
+import { useEffect, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { useNavigate } from "react-router-dom";
+import { sendOidcLoginToken } from "../../../api/api.ts";
+import { setHeadlessFrameLoading } from "../../../redux/globalStateSlice.ts";
+import { useAppDispatch } from "../../../redux/hooks.ts";
+import { refreshUserSession } from "../../../redux/thunks/session.ts";
+import PageTitle from "../../../router/PageTitle.tsx";
+import { useQuery } from "../../../util";
+import DismissCircleFilled from "../../Icons/DismissCircleFilled.tsx";
+
+// Messages for the error codes of the backend (service/oidclogin).
+const errorMessages: { [code: string]: string } = {
+  cancelled: "Sign-in was cancelled.",
+  no_access: "Your account has no access to this site. Ask an administrator for access.",
+  unverified:
+    "An account with your email address already exists here. An administrator has to mark your email address as verified before you can use it.",
+  conflict: "The account with your email address is already linked to someone else.",
+  blocked: "This account has been blocked.",
+  no_email: "Your account has no email address.",
+  unavailable: "Single sign-on is not available right now. Please try again later.",
+  failed: "Sign-in failed. Please try again.",
+};
+
+// Finishes an OpenID Connect sign-in: the backend left the result in an
+// HttpOnly cookie, which is redeemed here for a normal session.
+const OidcCallback = () => {
+  const { t } = useTranslation();
+  const dispatch = useAppDispatch();
+  const navigate = useNavigate();
+  const query = useQuery();
+  const [error, setError] = useState<string | undefined>(undefined);
+  const redirect = query.get("redirect");
+
+  useEffect(() => {
+    const code = query.get("error");
+    if (code) {
+      setError(code);
+      return;
+    }
+
+    dispatch(setHeadlessFrameLoading(true));
+    dispatch(sendOidcLoginToken())
+      .then((response) => {
+        dispatch(refreshUserSession(response, redirect));
+      })
+      .catch(() => setError("failed"))
+      .finally(() => dispatch(setHeadlessFrameLoading(false)));
+  }, []);
+
+  const back = () => navigate("/session" + (redirect ? "?redirect=" + encodeURIComponent(redirect) : ""));
+
+  return (
+    <Box>
+      <PageTitle title={t("login.signIn")} />
+      {error && (
+        <>
+          <Box sx={{ display: "flex", flexDirection: "column", alignItems: "center", py: 5 }}>
+            <DismissCircleFilled fontSize={"large"} color={"error"} />
+            <Typography variant={"body1"} sx={{ mt: 2, textAlign: "center" }}>
+              {t("login.oidcError." + error, { defaultValue: errorMessages[error] ?? errorMessages.failed })}
+            </Typography>
+          </Box>
+          <Button onClick={back} fullWidth variant="contained" color="primary">
+            {t("login.backToSingIn")}
+          </Button>
+        </>
+      )}
+    </Box>
+  );
+};
+
+export default OidcCallback;
