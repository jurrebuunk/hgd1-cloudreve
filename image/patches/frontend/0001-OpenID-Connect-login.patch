diff --git a/src/api/api.ts b/src/api/api.ts
index 6cc4499..bdf7a75 100644
--- a/src/api/api.ts
+++ b/src/api/api.ts
@@ -2189,3 +2189,46 @@ export function sendRebuildFTSIndex(req: RebuildFTSIndexWorkflowService): ThunkR
     );
   };
 }
+
+export interface OidcLoginInfo {
+  enabled: boolean;
+  display_name?: string;
+}
+
+// OpenID Connect login (backend: service/oidclogin).
+export function getOidcLoginInfo(): ThunkResponse<OidcLoginInfo> {
+  return async (dispatch, _getState) => {
+    return await dispatch(
+      send(
+        `/session/oidc`,
+        {
+          method: "GET",
+        },
+        {
+          ...defaultOpts,
+          noCredential: true,
+          bypassSnackbar: () => true,
+        },
+      ),
+    );
+  };
+}
+
+// Redeems the finished OIDC login (an HttpOnly cookie) for a token pair.
+export function sendOidcLoginToken(): ThunkResponse<LoginResponse> {
+  return async (dispatch, _getState) => {
+    return await dispatch(
+      send(
+        `/session/oidc/token`,
+        {
+          method: "POST",
+        },
+        {
+          ...defaultOpts,
+          noCredential: true,
+          bypassSnackbar: () => true,
+        },
+      ),
+    );
+  };
+}
