diff --git a/routers/controllers/oidc_login.go b/routers/controllers/oidc_login.go
new file mode 100644
index 0000000..90b740b
--- /dev/null
+++ b/routers/controllers/oidc_login.go
@@ -0,0 +1,138 @@
+package controllers
+
+import (
+	"errors"
+	"net/http"
+	"net/url"
+
+	"github.com/cloudreve/Cloudreve/v4/application/dependency"
+	"github.com/cloudreve/Cloudreve/v4/inventory"
+	"github.com/cloudreve/Cloudreve/v4/pkg/serializer"
+	"github.com/cloudreve/Cloudreve/v4/pkg/util"
+	"github.com/cloudreve/Cloudreve/v4/service/oidclogin"
+	"github.com/gin-gonic/gin"
+)
+
+const (
+	oidcDonePrefix = "oidc_done_"
+	// oidcFrontendPath is the frontend page that finishes the login.
+	oidcFrontendPath = "/session/oidc"
+)
+
+// OIDCLoginInfo tells the login page whether to show the OIDC button.
+func OIDCLoginInfo(c *gin.Context) {
+	cfg, ok := oidclogin.Enabled()
+	if !ok {
+		c.JSON(200, serializer.Response{Data: gin.H{"enabled": false}})
+		return
+	}
+	c.JSON(200, serializer.Response{Data: gin.H{"enabled": true, "display_name": cfg.DisplayName}})
+}
+
+// OIDCLoginStart redirects to the provider.
+func OIDCLoginStart(c *gin.Context) {
+	dep := dependency.FromContext(c)
+	p, err := oidclogin.Get()
+	if err != nil {
+		if !errors.Is(err, oidclogin.ErrDisabled) {
+			dep.Logger().Error("OIDC login unavailable: %s", err)
+		}
+		oidcFail(c, "unavailable", "")
+		return
+	}
+
+	target, err := p.Start(c.Writer, c.Query("redirect"))
+	if err != nil {
+		dep.Logger().Error("Failed to start OIDC login: %s", err)
+		oidcFail(c, "failed", "")
+		return
+	}
+	c.Header("Cache-Control", "no-store")
+	c.Redirect(http.StatusFound, target)
+}
+
+// OIDCLoginCallback finishes the provider's side of the login and leaves a
+// single-use handle for OIDCLoginToken.
+func OIDCLoginCallback(c *gin.Context) {
+	dep := dependency.FromContext(c)
+	c.Header("Cache-Control", "no-store")
+	p, err := oidclogin.Get()
+	if err != nil {
+		oidcFail(c, "unavailable", "")
+		return
+	}
+
+	id, redirect, err := p.Finish(c, c.Writer, c.Request)
+	if err != nil {
+		dep.Logger().Warning("OIDC login rejected: %s", err)
+		code := "failed"
+		if c.Query("error") == "access_denied" {
+			code = "cancelled"
+		}
+		oidcFail(c, code, redirect)
+		return
+	}
+
+	u, err := oidclogin.ResolveUser(c, p.Config, dep.UserClient(), id)
+	if err != nil {
+		dep.Logger().Warning("OIDC login for subject %q (%s) rejected: %s", id.Subject, id.Email, err)
+		oidcFail(c, oidclogin.ErrorCode(err), redirect)
+		return
+	}
+
+	handle := oidclogin.NewHandle()
+	if err := dep.KV().Set(oidcDonePrefix+handle, u.ID, int(oidclogin.DoneTTL().Seconds())); err != nil {
+		dep.Logger().Error("Failed to store OIDC login: %s", err)
+		oidcFail(c, "failed", redirect)
+		return
+	}
+	p.SetDone(c.Writer, handle)
+	dep.Logger().Info("OIDC login for user %d (subject %q)", u.ID, id.Subject)
+	c.Redirect(http.StatusFound, oidcFrontendPath+"?redirect="+url.QueryEscape(redirect))
+}
+
+// OIDCLoginToken redeems the handle cookie and puts the user in the context;
+// UserIssueToken comes next in the chain.
+func OIDCLoginToken(c *gin.Context) {
+	dep := dependency.FromContext(c)
+	c.Header("Cache-Control", "no-store")
+	p, err := oidclogin.Get()
+	if err != nil {
+		c.JSON(200, serializer.Err(c, serializer.NewError(serializer.CodeNoPermissionErr, "OIDC login is not available", err)))
+		c.Abort()
+		return
+	}
+
+	handle := p.TakeDone(c.Writer, c.Request)
+	if handle == "" {
+		c.JSON(200, serializer.Err(c, serializer.NewError(serializer.CodeParamErr, "No pending sign-in", nil)))
+		c.Abort()
+		return
+	}
+	v, ok := dep.KV().Get(oidcDonePrefix + handle)
+	_ = dep.KV().Delete(oidcDonePrefix, handle)
+	uid, isInt := v.(int)
+	if !ok || !isInt {
+		c.JSON(200, serializer.Err(c, serializer.NewError(serializer.CodeParamErr, "Sign-in expired, please try again", nil)))
+		c.Abort()
+		return
+	}
+
+	u, err := oidclogin.LoadUser(c, dep.UserClient(), uid)
+	if err != nil {
+		c.JSON(200, serializer.Err(c, serializer.NewError(serializer.CodeUserBaned, "This account has been blocked", err)))
+		c.Abort()
+		return
+	}
+	util.WithValue(c, inventory.UserCtx{}, u)
+	c.Next()
+}
+
+func oidcFail(c *gin.Context, code, redirect string) {
+	q := url.Values{"error": {code}}
+	if redirect != "" && redirect != "/home" {
+		q.Set("redirect", redirect)
+	}
+	c.Redirect(http.StatusFound, oidcFrontendPath+"?"+q.Encode())
+	c.Abort()
+}
