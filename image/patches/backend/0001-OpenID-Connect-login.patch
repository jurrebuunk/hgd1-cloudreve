diff --git a/service/oidclogin/oidclogin.go b/service/oidclogin/oidclogin.go
new file mode 100644
index 0000000..7857b27
--- /dev/null
+++ b/service/oidclogin/oidclogin.go
@@ -0,0 +1,488 @@
+// Package oidclogin lets people sign in with an external OpenID Connect
+// provider (Keycloak): authorization code flow with PKCE, state and nonce,
+// for a confidential client. It is configured from the environment and stays
+// off when OIDC_ISSUER is not set.
+//
+// Flow:
+//  1. GET  /api/v4/session/oidc/login     → provider; the flow's state, nonce and
+//     PKCE verifier travel in an encrypted, HttpOnly cookie.
+//  2. GET  /api/v4/session/oidc/callback  → checks state against that cookie,
+//     redeems the code, verifies the ID token and its nonce, maps it to a user,
+//     and leaves a single-use handle (60 s) in a second HttpOnly cookie.
+//  3. POST /api/v4/session/oidc/token     → redeems the handle for the usual
+//     Cloudreve token pair (the same UserIssueToken step as password login).
+//
+// No token or code ever ends up in a URL that Cloudreve's frontend sees.
+package oidclogin
+
+import (
+	"context"
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/rand"
+	"crypto/subtle"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/url"
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/coreos/go-oidc/v3/oidc"
+	"golang.org/x/oauth2"
+)
+
+const (
+	// Env vars. Not CR_*: Cloudreve logs the values of those.
+	EnvIssuer           = "OIDC_ISSUER"
+	EnvClientID         = "OIDC_CLIENT_ID"
+	EnvClientSecretFile = "OIDC_CLIENT_SECRET_FILE"
+	EnvRedirectURL      = "OIDC_REDIRECT_URL"
+	EnvDisplayName      = "OIDC_DISPLAY_NAME"
+	EnvRoleClaim        = "OIDC_ROLE_CLAIM"
+	EnvRoleGroups       = "OIDC_ROLE_GROUPS"
+
+	// CookiePath limits both cookies to the OIDC endpoints.
+	CookiePath  = "/api/v4/session/oidc"
+	flowCookie  = "cr_oidc_flow"
+	doneCookie  = "cr_oidc_done"
+	flowTTL     = 10 * time.Minute
+	doneTTL     = 60 * time.Second
+	httpTimeout = 15 * time.Second
+)
+
+// RoleGroup maps a role from the ID token to a Cloudreve group ID.
+type RoleGroup struct {
+	Role    string
+	GroupID int
+}
+
+// Config is read once from the environment.
+type Config struct {
+	Issuer       string
+	ClientID     string
+	ClientSecret string
+	RedirectURL  string
+	DisplayName  string
+	RoleClaim    string
+	// RoleGroups in priority order: the first role the user has decides the group.
+	RoleGroups []RoleGroup
+}
+
+// ConfigFromEnv returns nil, nil when OIDC is not configured.
+func ConfigFromEnv() (*Config, error) {
+	issuer := os.Getenv(EnvIssuer)
+	if issuer == "" {
+		return nil, nil
+	}
+
+	cfg := &Config{
+		Issuer:      issuer,
+		ClientID:    os.Getenv(EnvClientID),
+		RedirectURL: os.Getenv(EnvRedirectURL),
+		DisplayName: os.Getenv(EnvDisplayName),
+		RoleClaim:   os.Getenv(EnvRoleClaim),
+	}
+	if cfg.DisplayName == "" {
+		cfg.DisplayName = "OpenID Connect"
+	}
+	if cfg.RoleClaim == "" {
+		cfg.RoleClaim = "roles"
+	}
+	if cfg.ClientID == "" || cfg.RedirectURL == "" {
+		return nil, fmt.Errorf("%s and %s are required with %s", EnvClientID, EnvRedirectURL, EnvIssuer)
+	}
+	if u, err := url.Parse(cfg.RedirectURL); err != nil || !u.IsAbs() {
+		return nil, fmt.Errorf("%s must be an absolute URL", EnvRedirectURL)
+	}
+
+	secretFile := os.Getenv(EnvClientSecretFile)
+	if secretFile == "" {
+		return nil, fmt.Errorf("%s is required with %s", EnvClientSecretFile, EnvIssuer)
+	}
+	secret, err := os.ReadFile(secretFile)
+	if err != nil {
+		return nil, fmt.Errorf("failed to read %s: %w", EnvClientSecretFile, err)
+	}
+	cfg.ClientSecret = strings.TrimSpace(string(secret))
+	if cfg.ClientSecret == "" {
+		return nil, fmt.Errorf("%s is empty", EnvClientSecretFile)
+	}
+
+	cfg.RoleGroups, err = ParseRoleGroups(os.Getenv(EnvRoleGroups))
+	if err != nil {
+		return nil, err
+	}
+	return cfg, nil
+}
+
+// ParseRoleGroups parses "admin=1,user=2".
+func ParseRoleGroups(s string) ([]RoleGroup, error) {
+	var res []RoleGroup
+	for _, part := range strings.Split(s, ",") {
+		part = strings.TrimSpace(part)
+		if part == "" {
+			continue
+		}
+		role, id, ok := strings.Cut(part, "=")
+		gid, err := strconv.Atoi(strings.TrimSpace(id))
+		if !ok || strings.TrimSpace(role) == "" || err != nil || gid <= 0 {
+			return nil, fmt.Errorf("%s: invalid entry %q, expected role=groupID", EnvRoleGroups, part)
+		}
+		res = append(res, RoleGroup{Role: strings.TrimSpace(role), GroupID: gid})
+	}
+	if len(res) == 0 {
+		return nil, fmt.Errorf("%s is required: without it nobody could sign in", EnvRoleGroups)
+	}
+	return res, nil
+}
+
+// GroupFor returns the group of the first configured role the user has.
+func (c *Config) GroupFor(roles []string) (int, bool) {
+	for _, rg := range c.RoleGroups {
+		for _, r := range roles {
+			if r == rg.Role {
+				return rg.GroupID, true
+			}
+		}
+	}
+	return 0, false
+}
+
+// Identity is what Cloudreve takes from a verified ID token.
+type Identity struct {
+	Subject       string
+	Email         string
+	EmailVerified bool
+	Name          string
+	Roles         []string
+	// Picture is the provider's picture claim, if it is an https address
+	// (the hub's /avatars/…); it becomes the account's avatar.
+	Picture string
+}
+
+// Provider holds the discovered provider and the client settings.
+type Provider struct {
+	Config   *Config
+	oauth    oauth2.Config
+	verifier *oidc.IDTokenVerifier
+	client   *http.Client
+	aead     cipher.AEAD
+	now      func() time.Time
+}
+
+var (
+	mu      sync.Mutex
+	current *Provider
+	// The config is read once; a broken one is reported on every request.
+	cfgCache   *Config
+	configErr  error
+	configRead bool
+)
+
+// ErrDisabled is returned when OIDC_ISSUER is not set.
+var ErrDisabled = errors.New("oidc login is not configured")
+
+// Enabled reports whether OIDC is configured (without contacting the provider).
+func Enabled() (*Config, bool) {
+	mu.Lock()
+	defer mu.Unlock()
+	cfg, err := readConfigLocked()
+	return cfg, err == nil && cfg != nil
+}
+
+func readConfigLocked() (*Config, error) {
+	if !configRead {
+		cfgCache, configErr = ConfigFromEnv()
+		configRead = true
+	}
+	return cfgCache, configErr
+}
+
+// Get returns the provider, discovering it on first use. Discovery is retried
+// on the next request when the provider was unreachable.
+func Get() (*Provider, error) {
+	mu.Lock()
+	defer mu.Unlock()
+	if current != nil {
+		return current, nil
+	}
+	cfg, err := readConfigLocked()
+	if err != nil {
+		return nil, err
+	}
+	if cfg == nil {
+		return nil, ErrDisabled
+	}
+	p, err := NewProvider(context.Background(), cfg, &http.Client{Timeout: httpTimeout})
+	if err != nil {
+		return nil, err
+	}
+	current = p
+	return p, nil
+}
+
+// NewProvider discovers the issuer. ctx must outlive the provider: go-oidc
+// uses it for later key set fetches.
+func NewProvider(ctx context.Context, cfg *Config, client *http.Client) (*Provider, error) {
+	ctx = oidc.ClientContext(ctx, client)
+	p, err := oidc.NewProvider(ctx, cfg.Issuer)
+	if err != nil {
+		return nil, fmt.Errorf("failed to discover OIDC issuer: %w", err)
+	}
+
+	// A fresh key per process: a flow that spans a restart has to start over.
+	key := make([]byte, 32)
+	if _, err := rand.Read(key); err != nil {
+		return nil, err
+	}
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, err
+	}
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, err
+	}
+
+	return &Provider{
+		Config: cfg,
+		oauth: oauth2.Config{
+			ClientID:     cfg.ClientID,
+			ClientSecret: cfg.ClientSecret,
+			Endpoint:     p.Endpoint(),
+			RedirectURL:  cfg.RedirectURL,
+			Scopes:       []string{oidc.ScopeOpenID, "profile", "email"},
+		},
+		verifier: p.Verifier(&oidc.Config{ClientID: cfg.ClientID}),
+		client:   client,
+		aead:     aead,
+		now:      time.Now,
+	}, nil
+}
+
+// flowState is what the flow cookie carries between login and callback.
+type flowState struct {
+	State    string `json:"s"`
+	Nonce    string `json:"n"`
+	Verifier string `json:"v"`
+	Redirect string `json:"r"`
+	Expires  int64  `json:"e"`
+}
+
+// Start begins a login: it sets the flow cookie and returns the provider URL.
+func (p *Provider) Start(w http.ResponseWriter, redirect string) (string, error) {
+	st := flowState{
+		State:    randomString(),
+		Nonce:    randomString(),
+		Verifier: oauth2.GenerateVerifier(),
+		Redirect: SafeRedirect(redirect),
+		Expires:  p.now().Add(flowTTL).Unix(),
+	}
+	sealed, err := p.seal(st)
+	if err != nil {
+		return "", err
+	}
+	p.setCookie(w, flowCookie, sealed, flowTTL, http.SameSiteLaxMode)
+	return p.oauth.AuthCodeURL(st.State, oidc.Nonce(st.Nonce), oauth2.S256ChallengeOption(st.Verifier)), nil
+}
+
+// ErrFlow means the callback doesn't belong to a login this browser started
+// (missing, expired or mismatched state).
+var ErrFlow = errors.New("invalid or expired login state")
+
+// Finish handles the callback: checks state, redeems the code and verifies
+// the ID token. It returns the identity and where to go afterwards (empty
+// when the state is unusable, since the redirect came with it).
+func (p *Provider) Finish(ctx context.Context, w http.ResponseWriter, r *http.Request) (*Identity, string, error) {
+	cookie, err := r.Cookie(flowCookie)
+	p.clearCookie(w, flowCookie, http.SameSiteLaxMode)
+	if err != nil {
+		return nil, "", ErrFlow
+	}
+	var st flowState
+	if err := p.open(cookie.Value, &st); err != nil {
+		return nil, "", ErrFlow
+	}
+	q := r.URL.Query()
+	if st.Expires < p.now().Unix() || q.Get("state") == "" ||
+		subtle.ConstantTimeCompare([]byte(q.Get("state")), []byte(st.State)) != 1 {
+		return nil, "", ErrFlow
+	}
+	if e := q.Get("error"); e != "" {
+		return nil, st.Redirect, fmt.Errorf("provider returned error %q: %s", e, q.Get("error_description"))
+	}
+	code := q.Get("code")
+	if code == "" {
+		return nil, st.Redirect, errors.New("callback without code")
+	}
+
+	ctx = oidc.ClientContext(ctx, p.client)
+	token, err := p.oauth.Exchange(ctx, code, oauth2.VerifierOption(st.Verifier))
+	if err != nil {
+		return nil, st.Redirect, fmt.Errorf("failed to redeem code: %w", err)
+	}
+	rawID, ok := token.Extra("id_token").(string)
+	if !ok || rawID == "" {
+		return nil, st.Redirect, errors.New("token response without id_token")
+	}
+	idToken, err := p.verifier.Verify(ctx, rawID)
+	if err != nil {
+		return nil, st.Redirect, fmt.Errorf("invalid id_token: %w", err)
+	}
+	if subtle.ConstantTimeCompare([]byte(idToken.Nonce), []byte(st.Nonce)) != 1 {
+		return nil, st.Redirect, errors.New("id_token nonce mismatch")
+	}
+
+	id, err := p.identity(idToken)
+	if err != nil {
+		return nil, st.Redirect, err
+	}
+	return id, st.Redirect, nil
+}
+
+func (p *Provider) identity(idToken *oidc.IDToken) (*Identity, error) {
+	var claims map[string]any
+	if err := idToken.Claims(&claims); err != nil {
+		return nil, fmt.Errorf("failed to parse claims: %w", err)
+	}
+	id := &Identity{Subject: idToken.Subject}
+	if id.Subject == "" {
+		return nil, errors.New("id_token without sub")
+	}
+	id.Email, _ = claims["email"].(string)
+	id.EmailVerified, _ = claims["email_verified"].(bool)
+	id.Name, _ = claims["name"].(string)
+	if id.Name == "" {
+		id.Name, _ = claims["preferred_username"].(string)
+	}
+	if pic, ok := claims["picture"].(string); ok && IsPictureURL(pic) {
+		id.Picture = pic
+	}
+	if roles, ok := claims[p.Config.RoleClaim].([]any); ok {
+		for _, r := range roles {
+			if s, ok := r.(string); ok {
+				id.Roles = append(id.Roles, s)
+			}
+		}
+	}
+	return id, nil
+}
+
+// SetDone stores the handle of a finished login in its cookie.
+func (p *Provider) SetDone(w http.ResponseWriter, handle string) {
+	p.setCookie(w, doneCookie, handle, doneTTL, http.SameSiteStrictMode)
+}
+
+// TakeDone reads and clears the handle cookie.
+func (p *Provider) TakeDone(w http.ResponseWriter, r *http.Request) string {
+	cookie, err := r.Cookie(doneCookie)
+	p.clearCookie(w, doneCookie, http.SameSiteStrictMode)
+	if err != nil {
+		return ""
+	}
+	return cookie.Value
+}
+
+// DoneTTL is how long a finished login can be picked up.
+func DoneTTL() time.Duration { return doneTTL }
+
+func (p *Provider) secure() bool {
+	return strings.HasPrefix(p.Config.RedirectURL, "https://")
+}
+
+func (p *Provider) setCookie(w http.ResponseWriter, name, value string, ttl time.Duration, ss http.SameSite) {
+	http.SetCookie(w, &http.Cookie{
+		Name:     name,
+		Value:    value,
+		Path:     CookiePath,
+		MaxAge:   int(ttl.Seconds()),
+		HttpOnly: true,
+		Secure:   p.secure(),
+		SameSite: ss,
+	})
+}
+
+func (p *Provider) clearCookie(w http.ResponseWriter, name string, ss http.SameSite) {
+	http.SetCookie(w, &http.Cookie{
+		Name:     name,
+		Value:    "",
+		Path:     CookiePath,
+		MaxAge:   -1,
+		HttpOnly: true,
+		Secure:   p.secure(),
+		SameSite: ss,
+	})
+}
+
+func (p *Provider) seal(v any) (string, error) {
+	plain, err := json.Marshal(v)
+	if err != nil {
+		return "", err
+	}
+	nonce := make([]byte, p.aead.NonceSize())
+	if _, err := rand.Read(nonce); err != nil {
+		return "", err
+	}
+	return base64.RawURLEncoding.EncodeToString(p.aead.Seal(nonce, nonce, plain, []byte(flowCookie))), nil
+}
+
+func (p *Provider) open(s string, v any) error {
+	raw, err := base64.RawURLEncoding.DecodeString(s)
+	if err != nil || len(raw) < p.aead.NonceSize() {
+		return ErrFlow
+	}
+	n := p.aead.NonceSize()
+	plain, err := p.aead.Open(nil, raw[:n], raw[n:], []byte(flowCookie))
+	if err != nil {
+		return ErrFlow
+	}
+	return json.Unmarshal(plain, v)
+}
+
+// SafeRedirect keeps only paths on this site ("/..."), never another host.
+func SafeRedirect(r string) string {
+	const fallback = "/home"
+	if !strings.HasPrefix(r, "/") || strings.HasPrefix(r, "//") ||
+		strings.ContainsAny(r, "\\\x00\r\n\t") {
+		return fallback
+	}
+	u, err := url.Parse(r)
+	if err != nil || u.IsAbs() || u.Host != "" || u.User != nil {
+		return fallback
+	}
+	// Decoded, the path must still be a plain local path.
+	if strings.HasPrefix(u.Path, "//") || strings.ContainsAny(u.Path, "\\") {
+		return fallback
+	}
+	for _, seg := range strings.Split(u.Path, "/") {
+		if seg == ".." || seg == "." {
+			return fallback
+		}
+	}
+	return r
+}
+
+func randomString() string {
+	b := make([]byte, 32)
+	if _, err := rand.Read(b); err != nil {
+		panic(err)
+	}
+	return base64.RawURLEncoding.EncodeToString(b)
+}
+
+// NewHandle returns a random single-use handle for a finished login.
+func NewHandle() string { return randomString() }
+
+// IsPictureURL says whether s is a picture address from the provider: an
+// absolute https URL. Cloudreve's own avatar values are "", "file" and
+// "gravatar", so it also tells an avatar set from the picture claim apart.
+func IsPictureURL(s string) bool {
+	u, err := url.Parse(s)
+	return err == nil && u.Scheme == "https" && u.Host != "" && u.User == nil && len(s) <= 2048
+}
diff --git a/service/oidclogin/oidclogin_test.go b/service/oidclogin/oidclogin_test.go
new file mode 100644
index 0000000..e63c07b
--- /dev/null
+++ b/service/oidclogin/oidclogin_test.go
@@ -0,0 +1,316 @@
+package oidclogin
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/go-jose/go-jose/v4"
+)
+
+const (
+	testClientID     = "cloudreve"
+	testClientSecret = "s3cret"
+	testRedirect     = "https://files.example.org/api/v4/session/oidc/callback"
+)
+
+// fakeIssuer is a minimal OIDC provider: discovery, JWKS and a token
+// endpoint that checks the client secret, the code and the PKCE verifier.
+type fakeIssuer struct {
+	srv  *httptest.Server
+	key  *rsa.PrivateKey
+	kid  string
+	code string
+	// set by the test before the token request
+	challenge string
+	claims    map[string]any
+	signWith  *rsa.PrivateKey
+}
+
+func newFakeIssuer(t *testing.T) *fakeIssuer {
+	t.Helper()
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	f := &fakeIssuer{key: key, kid: "k1", code: "the-code"}
+	mux := http.NewServeMux()
+	mux.HandleFunc("/.well-known/openid-configuration", func(w http.ResponseWriter, r *http.Request) {
+		_ = json.NewEncoder(w).Encode(map[string]any{
+			"issuer":                                f.srv.URL,
+			"authorization_endpoint":                f.srv.URL + "/auth",
+			"token_endpoint":                        f.srv.URL + "/token",
+			"jwks_uri":                              f.srv.URL + "/jwks",
+			"id_token_signing_alg_values_supported": []string{"RS256"},
+		})
+	})
+	mux.HandleFunc("/jwks", func(w http.ResponseWriter, r *http.Request) {
+		_ = json.NewEncoder(w).Encode(jose.JSONWebKeySet{Keys: []jose.JSONWebKey{
+			{Key: &f.key.PublicKey, KeyID: f.kid, Algorithm: "RS256", Use: "sig"},
+		}})
+	})
+	mux.HandleFunc("/token", func(w http.ResponseWriter, r *http.Request) {
+		_ = r.ParseForm()
+		id, secret, _ := r.BasicAuth()
+		if id != testClientID || secret != testClientSecret {
+			http.Error(w, `{"error":"invalid_client"}`, 401)
+			return
+		}
+		sum := sha256.Sum256([]byte(r.PostForm.Get("code_verifier")))
+		if r.PostForm.Get("code") != f.code || r.PostForm.Get("redirect_uri") != testRedirect ||
+			base64.RawURLEncoding.EncodeToString(sum[:]) != f.challenge {
+			http.Error(w, `{"error":"invalid_grant"}`, 400)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(map[string]any{
+			"access_token": "at", "token_type": "Bearer", "expires_in": 300,
+			"id_token": f.sign(t),
+		})
+	})
+	f.srv = httptest.NewServer(mux)
+	t.Cleanup(f.srv.Close)
+	return f
+}
+
+func (f *fakeIssuer) sign(t *testing.T) string {
+	key := f.key
+	if f.signWith != nil {
+		key = f.signWith
+	}
+	signer, err := jose.NewSigner(jose.SigningKey{Algorithm: jose.RS256, Key: key},
+		(&jose.SignerOptions{}).WithHeader("kid", f.kid))
+	if err != nil {
+		t.Fatal(err)
+	}
+	payload, _ := json.Marshal(f.claims)
+	obj, err := signer.Sign(payload)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s, _ := obj.CompactSerialize()
+	return s
+}
+
+func (f *fakeIssuer) baseClaims(nonce string) map[string]any {
+	now := time.Now()
+	return map[string]any{
+		"iss": f.srv.URL, "aud": testClientID, "sub": "user-1",
+		"iat": now.Unix(), "exp": now.Add(5 * time.Minute).Unix(),
+		"nonce": nonce, "email": "a@example.org", "email_verified": true,
+		"name": "Alice", "roles": []string{"user"},
+	}
+}
+
+func newTestProvider(t *testing.T, f *fakeIssuer) *Provider {
+	t.Helper()
+	cfg := &Config{
+		Issuer: f.srv.URL, ClientID: testClientID, ClientSecret: testClientSecret,
+		RedirectURL: testRedirect, RoleClaim: "roles",
+		RoleGroups: []RoleGroup{{"admin", 1}, {"user", 2}},
+	}
+	p, err := NewProvider(context.Background(), cfg, f.srv.Client())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+// start runs Start and returns the flow cookie and the auth URL's query.
+func start(t *testing.T, p *Provider, redirect string) (*http.Cookie, url.Values) {
+	t.Helper()
+	rec := httptest.NewRecorder()
+	target, err := p.Start(rec, redirect)
+	if err != nil {
+		t.Fatal(err)
+	}
+	u, _ := url.Parse(target)
+	cookies := rec.Result().Cookies()
+	if len(cookies) != 1 || cookies[0].Name != flowCookie {
+		t.Fatalf("expected the flow cookie, got %v", cookies)
+	}
+	c := cookies[0]
+	if !c.HttpOnly || !c.Secure || c.SameSite != http.SameSiteLaxMode || c.Path != CookiePath {
+		t.Fatalf("flow cookie attributes: %+v", c)
+	}
+	return c, u.Query()
+}
+
+// unsealNonce reads the nonce back from the flow cookie the way the callback does.
+func unsealNonce(t *testing.T, p *Provider, c *http.Cookie) string {
+	var st flowState
+	if err := p.open(c.Value, &st); err != nil {
+		t.Fatal(err)
+	}
+	return st.Nonce
+}
+
+func callback(p *Provider, cookie *http.Cookie, query string) (*Identity, string, error) {
+	req := httptest.NewRequest("GET", "/api/v4/session/oidc/callback?"+query, nil)
+	if cookie != nil {
+		req.AddCookie(cookie)
+	}
+	return p.Finish(context.Background(), httptest.NewRecorder(), req)
+}
+
+func TestFlow(t *testing.T) {
+	f := newFakeIssuer(t)
+	p := newTestProvider(t, f)
+
+	cookie, q := start(t, p, "/home?path=cloudreve%3A%2F%2Fmy")
+	if q.Get("code_challenge_method") != "S256" || q.Get("client_id") != testClientID ||
+		q.Get("redirect_uri") != testRedirect || !strings.Contains(q.Get("scope"), "openid") {
+		t.Fatalf("auth request: %v", q)
+	}
+	f.challenge = q.Get("code_challenge")
+	nonce := unsealNonce(t, p, cookie)
+	if q.Get("nonce") != nonce {
+		t.Fatal("nonce not sent")
+	}
+
+	tests := []struct {
+		name    string
+		mutate  func(claims map[string]any)
+		cookie  *http.Cookie
+		query   string
+		wantErr bool
+	}{
+		{name: "ok"},
+		{name: "no cookie", cookie: &http.Cookie{Name: "other"}, wantErr: true},
+		{name: "tampered cookie", cookie: &http.Cookie{Name: flowCookie, Value: cookie.Value[:len(cookie.Value)-4] + "AAAA"}, wantErr: true},
+		{name: "state mismatch", query: "state=wrong&code=the-code", wantErr: true},
+		{name: "missing state", query: "code=the-code", wantErr: true},
+		{name: "wrong code", query: "state=" + q.Get("state") + "&code=nope", wantErr: true},
+		{name: "provider error", query: "state=" + q.Get("state") + "&error=access_denied", wantErr: true},
+		{name: "nonce mismatch", mutate: func(c map[string]any) { c["nonce"] = "x" }, wantErr: true},
+		{name: "no nonce", mutate: func(c map[string]any) { delete(c, "nonce") }, wantErr: true},
+		{name: "wrong audience", mutate: func(c map[string]any) { c["aud"] = "other-app" }, wantErr: true},
+		{name: "wrong issuer", mutate: func(c map[string]any) { c["iss"] = "https://evil.example" }, wantErr: true},
+		{name: "expired", mutate: func(c map[string]any) { c["exp"] = time.Now().Add(-time.Minute).Unix() }, wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			f.claims = f.baseClaims(nonce)
+			if tt.mutate != nil {
+				tt.mutate(f.claims)
+			}
+			c := cookie
+			if tt.cookie != nil {
+				c = tt.cookie
+			}
+			query := tt.query
+			if query == "" {
+				query = "state=" + q.Get("state") + "&code=the-code"
+			}
+			id, redirect, err := callback(p, c, query)
+			if tt.wantErr {
+				if err == nil {
+					t.Fatal("expected an error")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if redirect != "/home?path=cloudreve%3A%2F%2Fmy" {
+				t.Fatalf("redirect = %q", redirect)
+			}
+			if id.Subject != "user-1" || id.Email != "a@example.org" || !id.EmailVerified ||
+				id.Name != "Alice" || len(id.Roles) != 1 || id.Roles[0] != "user" {
+				t.Fatalf("identity = %+v", id)
+			}
+		})
+	}
+}
+
+func TestBadSignature(t *testing.T) {
+	f := newFakeIssuer(t)
+	p := newTestProvider(t, f)
+	cookie, q := start(t, p, "")
+	f.challenge = q.Get("code_challenge")
+	f.claims = f.baseClaims(unsealNonce(t, p, cookie))
+	other, _ := rsa.GenerateKey(rand.Reader, 2048)
+	f.signWith = other
+	if _, _, err := callback(p, cookie, "state="+q.Get("state")+"&code=the-code"); err == nil {
+		t.Fatal("token signed with another key was accepted")
+	}
+}
+
+func TestFlowExpires(t *testing.T) {
+	f := newFakeIssuer(t)
+	p := newTestProvider(t, f)
+	cookie, q := start(t, p, "")
+	f.challenge = q.Get("code_challenge")
+	f.claims = f.baseClaims(unsealNonce(t, p, cookie))
+	p.now = func() time.Time { return time.Now().Add(flowTTL + time.Second) }
+	if _, _, err := callback(p, cookie, "state="+q.Get("state")+"&code=the-code"); err != ErrFlow {
+		t.Fatalf("expected ErrFlow, got %v", err)
+	}
+}
+
+func TestCookieFromOtherProcess(t *testing.T) {
+	f := newFakeIssuer(t)
+	p1 := newTestProvider(t, f)
+	p2 := newTestProvider(t, f)
+	cookie, q := start(t, p1, "")
+	if _, _, err := callback(p2, cookie, "state="+q.Get("state")+"&code=the-code"); err != ErrFlow {
+		t.Fatalf("expected ErrFlow, got %v", err)
+	}
+}
+
+func TestSafeRedirect(t *testing.T) {
+	for in, want := range map[string]string{
+		"":                           "/home",
+		"/home?path=x":               "/home?path=x",
+		"/s/abc":                     "/s/abc",
+		"//evil.example":             "/home",
+		"/\\evil.example":            "/home",
+		"https://evil.example":       "/home",
+		"javascript:alert(1)":        "/home",
+		"evil.example":               "/home",
+		"/ok\r\nSet-Cookie: x=y":     "/home",
+		"/%2F%2Fevil.example":        "/home",
+		"/%5Cevil.example":           "/home",
+		"/home/a%20b":                "/home/a%20b",
+		"\t//evil.example":           "/home",
+		"/home#frag":                 "/home#frag",
+		"/..//evil.example":          "/home",
+		"/./x":                       "/home",
+		"https:/\\/evil.example/x/y": "/home",
+	} {
+		if got := SafeRedirect(in); got != want {
+			t.Errorf("SafeRedirect(%q) = %q, want %q", in, got, want)
+		}
+	}
+}
+
+func TestParseRoleGroups(t *testing.T) {
+	rg, err := ParseRoleGroups(" admin=1, user=2 ,")
+	if err != nil || len(rg) != 2 || rg[0] != (RoleGroup{"admin", 1}) || rg[1] != (RoleGroup{"user", 2}) {
+		t.Fatalf("got %v, %v", rg, err)
+	}
+	for _, bad := range []string{"", "admin", "admin=", "=1", "admin=x", "admin=0", "admin=-1"} {
+		if _, err := ParseRoleGroups(bad); err == nil {
+			t.Errorf("ParseRoleGroups(%q) accepted", bad)
+		}
+	}
+	cfg := &Config{RoleGroups: rg}
+	if g, ok := cfg.GroupFor([]string{"user", "admin"}); !ok || g != 1 {
+		t.Errorf("admin should win: %d %v", g, ok)
+	}
+	if _, ok := cfg.GroupFor([]string{"other"}); ok {
+		t.Error("unknown role got access")
+	}
+	if _, ok := cfg.GroupFor(nil); ok {
+		t.Error("no roles got access")
+	}
+}
diff --git a/service/oidclogin/user.go b/service/oidclogin/user.go
new file mode 100644
index 0000000..17f89f1
--- /dev/null
+++ b/service/oidclogin/user.go
@@ -0,0 +1,185 @@
+package oidclogin
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"entgo.io/ent/dialect/sql"
+	"entgo.io/ent/dialect/sql/sqljson"
+	"github.com/cloudreve/Cloudreve/v4/ent"
+	"github.com/cloudreve/Cloudreve/v4/ent/predicate"
+	"github.com/cloudreve/Cloudreve/v4/ent/user"
+	"github.com/cloudreve/Cloudreve/v4/inventory"
+	"github.com/cloudreve/Cloudreve/v4/inventory/types"
+)
+
+// Reasons a verified identity can't sign in. Their Code is shown to the
+// person (as /session/oidc?error=<code>); details only go to the log.
+var (
+	ErrNoRole     = &LoginError{"no_access", "user has none of the configured roles"}
+	ErrNoEmail    = &LoginError{"no_email", "identity has no email address"}
+	ErrUnverified = &LoginError{"unverified", "email not verified at the provider; it matches an existing account that isn't linked yet"}
+	ErrConflict   = &LoginError{"conflict", "the account with this email is linked to a different identity"}
+	ErrBlocked    = &LoginError{"blocked", "account is not active"}
+)
+
+// LoginError is a refusal with a code that is safe to show.
+type LoginError struct {
+	Code string
+	msg  string
+}
+
+func (e *LoginError) Error() string { return e.msg }
+
+// ErrorCode is the code to show for err: a LoginError's own, else "failed".
+func ErrorCode(err error) string {
+	var le *LoginError
+	if errors.As(err, &le) {
+		return le.Code
+	}
+	return "failed"
+}
+
+// ResolveUser finds or creates the Cloudreve user for id and syncs its group.
+//
+//   - An account already linked to this subject (settings.oidc_sub) is used.
+//   - Otherwise an unlinked account with the same email is linked, but only
+//     when the provider says the email is verified.
+//   - Otherwise a new account is created.
+//
+// The group always follows the roles in the token, so taking a role away at
+// the provider takes the access away at the next sign-in.
+func ResolveUser(ctx context.Context, cfg *Config, uc inventory.UserClient, id *Identity) (*ent.User, error) {
+	groupID, ok := cfg.GroupFor(id.Roles)
+	if !ok {
+		return nil, ErrNoRole
+	}
+
+	client := uc.GetClient()
+	linked, err := client.User.Query().Where(subjectIs(id.Subject)).IDs(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("failed to look up linked user: %w", err)
+	}
+
+	var uid int
+	switch {
+	case len(linked) > 1:
+		return nil, fmt.Errorf("%d users linked to subject %q", len(linked), id.Subject)
+	case len(linked) == 1:
+		uid = linked[0]
+	default:
+		if id.Email == "" {
+			return nil, ErrNoEmail
+		}
+		existing, err := uc.GetByEmail(ctx, id.Email)
+		switch {
+		case err == nil:
+			if existing.Settings != nil && existing.Settings.OIDCSubject != "" {
+				return nil, ErrConflict
+			}
+			if !id.EmailVerified {
+				return nil, ErrUnverified
+			}
+			uid = existing.ID
+		case ent.IsNotFound(err):
+			created, err := uc.Create(ctx, &inventory.NewUserArgs{
+				Email:   id.Email,
+				Nick:    id.Name,
+				Status:  user.StatusActive,
+				GroupID: groupID,
+			})
+			if err != nil {
+				return nil, fmt.Errorf("failed to create user: %w", err)
+			}
+			uid = created.ID
+		default:
+			return nil, fmt.Errorf("failed to look up user by email: %w", err)
+		}
+		if err := link(ctx, client, uid, id.Subject); err != nil {
+			return nil, err
+		}
+	}
+
+	u, err := client.User.Get(ctx, uid)
+	if err != nil {
+		return nil, fmt.Errorf("failed to load user: %w", err)
+	}
+	if u.Status != user.StatusActive {
+		return nil, ErrBlocked
+	}
+	if u.GroupUsers != groupID {
+		if err := client.User.UpdateOneID(uid).SetGroupID(groupID).Exec(ctx); err != nil {
+			return nil, fmt.Errorf("failed to update group: %w", err)
+		}
+	}
+	if avatar := avatarFor(u.Avatar, id.Picture); avatar != u.Avatar {
+		if err := client.User.UpdateOneID(uid).SetAvatar(avatar).Exec(ctx); err != nil {
+			return nil, fmt.Errorf("failed to update avatar: %w", err)
+		}
+	}
+
+	return LoadUser(ctx, uc, uid)
+}
+
+// avatarFor is the avatar to keep after a sign-in. The provider's picture
+// wins: people set it once in the hub for every app. Without one, a picture
+// set earlier from the provider goes (removed there), but an avatar the
+// person uploaded in Cloudreve itself stays.
+func avatarFor(current, picture string) string {
+	if picture != "" {
+		return picture
+	}
+	if IsPictureURL(current) {
+		return ""
+	}
+	return current
+}
+
+// LoadUser loads an active user with its group, as login handlers expect.
+func LoadUser(ctx context.Context, uc inventory.UserClient, uid int) (*ent.User, error) {
+	ctx = context.WithValue(ctx, inventory.LoadUserGroup{}, true)
+	u, err := uc.GetActiveByID(ctx, uid)
+	if err != nil {
+		return nil, ErrBlocked
+	}
+	return u, nil
+}
+
+// link stores the subject in the user's settings. Done in a transaction that
+// re-checks nobody else got linked to this subject or this user meanwhile.
+func link(ctx context.Context, client *ent.Client, uid int, subject string) error {
+	tx, err := client.Tx(ctx)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+
+	if n, err := tx.User.Query().Where(subjectIs(subject)).Count(ctx); err != nil {
+		return err
+	} else if n > 0 {
+		return ErrConflict
+	}
+	u, err := tx.User.Get(ctx, uid)
+	if err != nil {
+		return err
+	}
+	settings := u.Settings
+	if settings == nil {
+		settings = &types.UserSetting{}
+	}
+	if settings.OIDCSubject != "" {
+		return ErrConflict
+	}
+	settings.OIDCSubject = subject
+	if err := tx.User.UpdateOneID(uid).SetSettings(settings).Exec(ctx); err != nil {
+		return fmt.Errorf("failed to link user: %w", err)
+	}
+	return tx.Commit()
+}
+
+func subjectIs(subject string) predicate.User {
+	return func(s *sql.Selector) {
+		s.Where(sqljson.ValueEQ(user.FieldSettings, subject, sqljson.Path("oidc_sub")))
+	}
+}
diff --git a/service/oidclogin/user_test.go b/service/oidclogin/user_test.go
new file mode 100644
index 0000000..7a2a3cc
--- /dev/null
+++ b/service/oidclogin/user_test.go
@@ -0,0 +1,184 @@
+package oidclogin
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"testing"
+
+	"github.com/cloudreve/Cloudreve/v4/ent"
+	"github.com/cloudreve/Cloudreve/v4/ent/enttest"
+	_ "github.com/cloudreve/Cloudreve/v4/ent/runtime"
+	"github.com/cloudreve/Cloudreve/v4/ent/user"
+	"github.com/cloudreve/Cloudreve/v4/inventory"
+	"github.com/cloudreve/Cloudreve/v4/inventory/types"
+	"github.com/cloudreve/Cloudreve/v4/pkg/boolset"
+	_ "github.com/lib/pq"
+)
+
+// newTestDB opens SQLite in memory, or a fresh Postgres database when OIDC_TEST_PG
+// is set to its DSN (production runs Postgres, and the JSON lookup is dialect-specific).
+func newTestDB(t *testing.T) *ent.Client {
+	t.Helper()
+	var client *ent.Client
+	if dsn := os.Getenv("OIDC_TEST_PG"); dsn != "" {
+		client = enttest.Open(t, "postgres", dsn)
+	} else {
+		client = enttest.Open(t, "sqlite3", fmt.Sprintf("file:%s?mode=memory&cache=shared", t.Name()))
+	}
+	t.Cleanup(func() { client.Close() })
+	ctx := context.Background()
+	// IDs 1, 2, 3 as on a real install (the database must be fresh).
+	for _, name := range []string{"Admin", "User", "Anonymous"} {
+		client.Group.Create().SetName(name).SetPermissions(&boolset.BooleanSet{}).ExecX(ctx)
+	}
+	// The first user is the local admin, as on a real install.
+	client.User.Create().SetEmail("admin@example.org").SetNick("admin").SetGroupID(1).
+		SetPassword("x:y").SetSettings(&types.UserSetting{}).ExecX(ctx)
+	return client
+}
+
+var testCfg = &Config{RoleGroups: []RoleGroup{{"admin", 1}, {"user", 2}}}
+
+func ident(sub, email string, verified bool, roles ...string) *Identity {
+	return &Identity{Subject: sub, Email: email, EmailVerified: verified, Name: "N " + sub, Roles: roles}
+}
+
+func TestResolveUser(t *testing.T) {
+	client := newTestDB(t)
+	uc := inventory.NewUserClient(client)
+	ctx := context.Background()
+
+	// New person: created, linked, in the role's group, with its group loaded.
+	u, err := ResolveUser(ctx, testCfg, uc, ident("s-bob", "bob@example.org", false, "user"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if u.Email != "bob@example.org" || u.GroupUsers != 2 || u.Settings.OIDCSubject != "s-bob" ||
+		u.Edges.Group == nil || u.Password != "" || u.Nick != "N s-bob" {
+		t.Fatalf("created user: %+v", u)
+	}
+
+	// Next login finds it by subject, even after the email changed at the provider.
+	u2, err := ResolveUser(ctx, testCfg, uc, ident("s-bob", "robert@example.org", true, "user"))
+	if err != nil || u2.ID != u.ID {
+		t.Fatalf("lookup by subject: %v %v", u2, err)
+	}
+
+	// Role change at the provider changes the group.
+	u3, err := ResolveUser(ctx, testCfg, uc, ident("s-bob", "", false, "admin", "user"))
+	if err != nil || u3.GroupUsers != 1 || u3.Edges.Group.ID != 1 {
+		t.Fatalf("promotion: %+v %v", u3, err)
+	}
+	u4, err := ResolveUser(ctx, testCfg, uc, ident("s-bob", "", false, "user"))
+	if err != nil || u4.GroupUsers != 2 {
+		t.Fatalf("demotion: %+v %v", u4, err)
+	}
+
+	// No role: no access, even for a linked account.
+	if _, err := ResolveUser(ctx, testCfg, uc, ident("s-bob", "", false)); err != ErrNoRole {
+		t.Fatalf("no role: %v", err)
+	}
+	if _, err := ResolveUser(ctx, testCfg, uc, ident("s-new", "new@example.org", true, "other")); err != ErrNoRole {
+		t.Fatalf("unknown role: %v", err)
+	}
+	if n := client.User.Query().Where(user.EmailEQ("new@example.org")).CountX(ctx); n != 0 {
+		t.Fatal("user created without a role")
+	}
+
+	// Existing local account: unverified email doesn't link it.
+	if _, err := ResolveUser(ctx, testCfg, uc, ident("s-admin", "ADMIN@example.org", false, "admin")); err != ErrUnverified {
+		t.Fatalf("unverified link: %v", err)
+	}
+	// Verified email links it (case-insensitive, like password login).
+	a, err := ResolveUser(ctx, testCfg, uc, ident("s-admin", "ADMIN@example.org", true, "admin"))
+	if err != nil || a.ID != 1 || a.Settings.OIDCSubject != "s-admin" || a.Password != "x:y" {
+		t.Fatalf("link: %+v %v", a, err)
+	}
+
+	// Another identity with the same (verified) email can't take the linked account.
+	if _, err := ResolveUser(ctx, testCfg, uc, ident("s-evil", "admin@example.org", true, "admin")); err != ErrConflict {
+		t.Fatalf("takeover: %v", err)
+	}
+
+	// No email and not linked: refused.
+	if _, err := ResolveUser(ctx, testCfg, uc, ident("s-x", "", true, "user")); err != ErrNoEmail {
+		t.Fatalf("no email: %v", err)
+	}
+
+	// Blocked accounts stay blocked.
+	client.User.UpdateOneID(u.ID).SetStatus(user.StatusManualBanned).ExecX(ctx)
+	if _, err := ResolveUser(ctx, testCfg, uc, ident("s-bob", "", false, "user")); err != ErrBlocked {
+		t.Fatalf("banned: %v", err)
+	}
+	if _, err := LoadUser(ctx, uc, u.ID); err != ErrBlocked {
+		t.Fatalf("banned LoadUser: %v", err)
+	}
+
+	// Other settings survive the link and later settings saves keep it.
+	a.Settings.PreferredTheme = "#123456"
+	if err := uc.SaveSettings(ctx, a); err != nil {
+		t.Fatal(err)
+	}
+	if got := client.User.GetX(ctx, 1).Settings; got.OIDCSubject != "s-admin" || got.PreferredTheme != "#123456" {
+		t.Fatalf("settings after save: %+v", got)
+	}
+}
+
+func TestErrorCode(t *testing.T) {
+	if ErrorCode(ErrConflict) != "conflict" || ErrorCode(fmt.Errorf("wrap: %w", ErrNoRole)) != "no_access" ||
+		ErrorCode(fmt.Errorf("db down")) != "failed" {
+		t.Fatal("error codes")
+	}
+}
+
+func TestPictureBecomesAvatar(t *testing.T) {
+	client := newTestDB(t)
+	uc := inventory.NewUserClient(client)
+	ctx := context.Background()
+	pic := "https://hub.example.org/avatars/s-ann/0123456789abcdef0123456789abcdef.jpg"
+	withPic := func(p string) *Identity {
+		id := ident("s-ann", "ann@example.org", true, "user")
+		id.Picture = p
+		return id
+	}
+
+	u, err := ResolveUser(ctx, testCfg, uc, withPic(pic))
+	if err != nil || u.Avatar != pic {
+		t.Fatalf("new account: avatar %q, %v", u.Avatar, err)
+	}
+	// A new picture replaces it; signing in without one clears ours.
+	pic2 := "https://hub.example.org/avatars/s-ann/ffffffffffffffffffffffffffffffff.jpg"
+	if u, _ = ResolveUser(ctx, testCfg, uc, withPic(pic2)); u.Avatar != pic2 {
+		t.Fatalf("new picture: %q", u.Avatar)
+	}
+	if u, _ = ResolveUser(ctx, testCfg, uc, withPic("")); u.Avatar != "" {
+		t.Fatalf("picture removed: %q", u.Avatar)
+	}
+	// An avatar uploaded in Cloudreve stays when there is no picture...
+	client.User.UpdateOneID(u.ID).SetAvatar("file").ExecX(ctx)
+	if u, _ = ResolveUser(ctx, testCfg, uc, withPic("")); u.Avatar != "file" {
+		t.Fatalf("own upload: %q", u.Avatar)
+	}
+	// ...and the provider's picture wins when there is one.
+	if u, _ = ResolveUser(ctx, testCfg, uc, withPic(pic)); u.Avatar != pic {
+		t.Fatalf("picture over upload: %q", u.Avatar)
+	}
+}
+
+func TestIsPictureURL(t *testing.T) {
+	for s, want := range map[string]bool{
+		"https://hub.buunk.org/avatars/a/b.jpg": true,
+		"http://hub.buunk.org/avatars/a/b.jpg":  false,
+		"javascript:alert(1)":                   false,
+		"//evil.example/x.jpg":                  false,
+		"https://user:pw@evil.example/x.jpg":    false,
+		"file":                                  false,
+		"gravatar":                              false,
+		"":                                      false,
+	} {
+		if got := IsPictureURL(s); got != want {
+			t.Errorf("IsPictureURL(%q) = %v", s, got)
+		}
+	}
+}
